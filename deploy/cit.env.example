# Source after conda activate hep. Course/storage paths below are examples:
# CIT must choose and mount them. No package or image installation occurs here.
export FINDINGZ_MG5=/opt/conda/envs/hep/MG5_aMC/bin/mg5_aMC
export FINDINGZ_PYTHIA8_DIR=/opt/conda/envs/hep
export FINDINGZ_DELPHES_DIR=/opt/conda/envs/hep/bin
export FINDINGZ_CARD_ROOT=/opt/conda/envs/hep
export FINDINGZ_CATALOG_PATH=/home/jovyan/course-materials/config/course_catalog.yaml
export FINDINGZ_VARIABLES_PATH=/home/jovyan/course-materials/config/analysis_variables.yaml
export FINDINGZ_RUN_ROOT=/home/jovyan/findingz-runs
# Optional simulation-stack label for run provenance and reuse, not verification
# or authentication. Change it when the underlying simulation tools change.
# export FINDINGZ_HEP_IMAGE_ID=cit-hep-v1
# Student-writable persistent destination, accessible in JupyterLab:
export FINDINGZ_NOTEBOOK_DIR=/home/jovyan/findingz-notebooks
# Set to the actual nbgitpuller checkout:
export FINDINGZ_NOTEBOOK_TEMPLATE=/home/jovyan/course-materials/notebooks/templates/analysis_template.ipynb
# FINDINGZ_NOTEBOOK_URL_PREFIX optionally maps NOTEBOOK_DIR to a JupyterLab
# lab/tree/ URL prefix. Leave unset on CIT unless its routing is configured.
# Saving works without a URL; students open the displayed file in JupyterLab.
# ServerProxy handles authentication and routing; no fixed per-user URL is needed.
