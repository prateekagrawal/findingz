# Existing local Docker layout, using the same installed application.
export FINDINGZ_MG5=/opt/hep/mg5/bin/mg5_aMC
export FINDINGZ_PYTHIA8_DIR=/opt/hep/mg5/HEPTools/pythia8
export FINDINGZ_DELPHES_DIR=/opt/hep/mg5/Delphes
export FINDINGZ_CATALOG_PATH=/course-config/course_catalog.yaml
export FINDINGZ_VARIABLES_PATH=/course-config/analysis_variables.yaml
export FINDINGZ_RUN_ROOT=/workspace/runs
export FINDINGZ_HEP_IMAGE_ID=findingz-hep-mg5-3.5.13-root-6.34.00
export FINDINGZ_NOTEBOOK_DIR=/workspace/notebooks
export FINDINGZ_NOTEBOOK_URL_PREFIX=http://localhost:8889/lab/tree/notebooks/
# Optional explicit root for custom cards; otherwise packaged cards take priority.
# export FINDINGZ_CARD_ROOT=/course-detectors
